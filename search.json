---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- capture entries -%}
{"t":"About","u":"{{ '/' | relative_url }}","k":"page","x":{{ site.description | append: ' spare time running cycling traveling hiking Hindi English French India IIT Delhi Godspeed Godquantum GDG Cloud Bangalore' | jsonify }}},
{"t":"CV","u":"{{ '/cv/' | relative_url }}","k":"page","x":{{ site.data.cv.summary | append: ' resume experience education Harvard Kennedy School Public Leadership Credential KIET B.Tech skills certifications pdf download' | jsonify }}},
{%- for job in site.data.cv.experience -%}
{"t":{{ job.org | append: ' — ' | append: job.role | jsonify }},"u":"{{ '/cv/' | relative_url }}","k":"cv","x":{{ job.bullets | join: ' ' | append: ' ' | append: job.dates | append: ' ' | append: job.location | jsonify }}},
{%- endfor -%}
{%- for e in site.essays -%}{%- unless e.published == false -%}
{"t":{{ e.title | jsonify }},"u":"{{ e.url | relative_url }}","k":"essay","d":"{{ e.date | date: '%b %Y' }}","x":{{ e.content | strip_html | normalize_whitespace | truncatewords: 400 | jsonify }}},
{%- endunless -%}{%- endfor -%}
{%- for e in site.data.essays_elsewhere -%}
{"t":{{ e.title | jsonify }},"u":{{ e.url | jsonify }},"k":"essay","d":"{{ e.date | date: '%b %Y' }}","x":""},
{%- endfor -%}
{%- for p in site.poems -%}{%- unless p.published == false -%}
{"t":{{ p.title | jsonify }},"u":"{{ p.url | relative_url }}","k":{{ p.kind | default: 'poem' | jsonify }},"d":"{{ p.date | date: '%b %Y' }}","x":{{ p.content | strip_html | normalize_whitespace | truncatewords: 200 | jsonify }}},
{%- endunless -%}{%- endfor -%}
{%- for s in site.data.stories -%}
{"t":{{ s.title | jsonify }},"u":{{ s.url | jsonify }},"k":{{ s.kind | jsonify }},"d":"{{ s.date | date: '%b %Y' }}","x":"wordpress"},
{%- endfor -%}
{%- for w in site.data.writing.medium -%}
{"t":{{ w.title | jsonify }},"u":{{ w.url | jsonify }},"k":"medium","d":"{{ w.date | date: '%b %Y' }}","x":{{ w.blurb | jsonify }}},
{%- endfor -%}
{%- for w in site.data.writing.substack -%}
{"t":{{ w.title | jsonify }},"u":{{ w.url | jsonify }},"k":"substack","d":"{{ w.date | date: '%b %Y' }}","x":{{ w.blurb | jsonify }}},
{%- endfor -%}
{%- for b in site.data.books.series -%}
{"t":{{ b.title | jsonify }},"u":"{{ '/books/' | relative_url }}","k":"book","x":{{ b.subtitle | append: ' ' | append: b.summary | jsonify }}},
{%- for c in b.chapters -%}
{"t":{{ b.title | append: ' · ' | append: c.title | jsonify }},"u":{{ c.url | jsonify }},"k":"book","d":"{{ c.date | date: '%b %Y' }}","x":""},
{%- endfor -%}
{%- endfor -%}
{%- for c in site.data.code.contributions -%}
{%- for i in c.items -%}
{"t":{{ i.title | jsonify }},"u":{{ i.url | jsonify }},"k":"code","d":"{{ i.date | date: '%b %Y' }}","x":{{ c.project | append: ' ' | append: c.language | append: ' ' | append: i.status | jsonify }}},
{%- endfor -%}
{%- endfor -%}
{%- for r in site.data.code.personal -%}
{"t":{{ r.name | jsonify }},"u":{{ r.url | jsonify }},"k":"code","d":"{{ r.year }}","x":{{ r.about | append: ' ' | append: r.language | jsonify }}},
{%- endfor -%}
{%- for p in site.data.projects -%}{%- assign tagstr = p.tags | join: ' ' -%}
{"t":{{ p.title | jsonify }},"u":"{{ '/projects/' | relative_url }}","k":"project","x":{{ p.summary | append: ' ' | append: tagstr | jsonify }}},
{%- endfor -%}
{%- for n in site.data.news -%}
{"t":{{ n.text | markdownify | strip_html | normalize_whitespace | truncatewords: 14 | jsonify }},"u":"{{ '/' | relative_url }}","k":"news","d":"{{ n.date | date: '%b %Y' }}","x":{{ n.text | markdownify | strip_html | normalize_whitespace | jsonify }}},
{%- endfor -%}
{%- for g in site.data.publications -%}{%- for p in g[1] -%}
{"t":{{ p.title | jsonify }},"u":"{{ '/publications/' | relative_url }}#{{ p.key }}","k":"paper","d":"{{ p.year }}","x":{{ p.abstract | append: ' ' | append: p.venue | jsonify }}},
{%- endfor -%}{%- endfor -%}
{%- for post in site.posts -%}
{"t":{{ post.title | jsonify }},"u":"{{ post.url | relative_url }}","k":"post","d":"{{ post.date | date: '%b %Y' }}","x":{{ post.content | strip_html | normalize_whitespace | truncatewords: 300 | jsonify }}},
{%- endfor -%}
{%- endcapture -%}
{{ entries | strip }}
{"t":"","u":"","k":"end","x":""}
]
